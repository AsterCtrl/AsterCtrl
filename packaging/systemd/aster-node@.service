[Unit]
Description=AsterCtrl node %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aster
Group=aster
EnvironmentFile=-/etc/aster/%i.env
ExecStart="@CMAKE_INSTALL_FULL_BINDIR@/aster_runtime" --config /opt/aster/%i/current/runtime.yaml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aster/%i
StateDirectory=aster/%i

[Install]
WantedBy=multi-user.target
