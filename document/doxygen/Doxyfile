PROJECT_NAME           = AsterCtrl
PROJECT_NUMBER         = 0.2.0-alpha.1
OUTPUT_DIRECTORY       = build/document/doxygen
CREATE_SUBDIRS         = NO

INPUT                  = src/interface/aster_module_c_interface \
                         src/interface/aster_module_cpp_interface \
                         src/interface/aster_pkg_c_interface \
                         src/interface/aster_core_plugin_interface
INPUT                 += src/runtime/aster_runtime
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp
STRIP_FROM_PATH        = src/interface

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SKIP_FUNCTION_MACROS   = NO
PREDEFINED             = ASTER_INTERFACE_EXPORT=
CPP_CLI_SUPPORT        = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES

HAVE_DOT               = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
