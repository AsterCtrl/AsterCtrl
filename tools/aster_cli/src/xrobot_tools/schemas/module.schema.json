{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "xrobot.io/v1alpha1"},
    "kind": {"const": "Module"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "ports", "executors"],
      "properties": {
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "class"],
          "properties": {
            "target": {"type": "string", "minLength": 1},
            "class": {"type": "string", "minLength": 1}
          }
        },
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "ports": {
          "type": "array",
          "items": {"$ref": "#/$defs/port"}
        },
        "executors": {
          "type": "array",
          "items": {"$ref": "#/$defs/executor"}
        },
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "hardware": {"type": "array", "items": {"type": "string"}},
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "same_node_required": {"type": "boolean"},
            "same_node_with": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "kind": {"enum": ["publisher", "subscriber", "service_client", "service_server", "action_client", "action_server"]},
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "qos": {"type": "string"}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "priority", "stack_bytes", "queue_depth"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 255},
        "stack_bytes": {"type": "integer", "minimum": 128},
        "queue_depth": {"type": "integer", "minimum": 1},
        "period_us": {"type": "integer", "minimum": 1},
        "exclusive": {"type": "boolean"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default", "mutability"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "type": {"enum": ["bool", "int32", "uint32", "float32", "float64"]},
        "default": {},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "unit": {"type": "string"},
        "mutability": {"enum": ["build", "startup", "runtime"]},
        "persistence": {"enum": ["compiled", "volatile", "persistent"]}
      }
    }
  }
}
