{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "packages"],
  "properties": {
    "api_version": {"const": "xrobot.io/v1alpha1"},
    "kind": {"const": "PackageLock"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace"],
      "properties": {"workspace": {"type": "string", "minLength": 1}}
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "commit"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    }
  }
}
