{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "xrobot.io/schema/v1alpha1"},
    "kind": {"enum": ["Message", "Service", "Action"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "namespace": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"}
      }
    },
    "spec": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "Message"}}},
      "then": {"properties": {"spec": {"$ref": "#/$defs/record"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "Service"}}},
      "then": {
        "properties": {
          "spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["request", "response"],
            "properties": {
              "request": {"$ref": "#/$defs/record"},
              "response": {"$ref": "#/$defs/record"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "Action"}}},
      "then": {
        "properties": {
          "spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["goal", "feedback", "result"],
            "properties": {
              "goal": {"$ref": "#/$defs/record"},
              "feedback": {"$ref": "#/$defs/record"},
              "result": {"$ref": "#/$defs/record"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "enums": {"type": "array", "items": {"$ref": "#/$defs/enum"}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      }
    },
    "enum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "underlying_type", "values"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "underlying_type": {"enum": ["int8", "uint8", "int16", "uint16", "int32", "uint32"]},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {"type": "string", "pattern": "^k[A-Z][A-Za-z0-9]*$"},
              "value": {"type": "integer"}
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"type": "string", "minLength": 1},
        "array": {"type": "integer", "minimum": 1},
        "default": {},
        "unit": {"type": "string", "minLength": 1}
      }
    }
  }
}
