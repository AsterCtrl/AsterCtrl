set(PACKAGE_VERSION "@ASTERCTRL_VERSION_STRING@")

# CMake package requests have no portable prerelease syntax. Refuse every
# numeric version request so 0.2.0-alpha.1 cannot masquerade as stable 0.2.0.
if(PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
  set(PACKAGE_VERSION_EXACT FALSE)
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
